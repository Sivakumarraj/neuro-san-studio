# Caddy in front of the Opportunity Desk (see start.sh). The host terminates TLS,
# so Caddy listens on plain HTTP on $PORT. Everything except the health check
# needs the owner's password; the hash comes from start.sh, never from this file.
{
	admin off
	auto_https off
}

:{$PORT:10000} {
	encode zstd gzip

	# The host's health check, without a password. nsflow answers it, so a dead
	# backend fails the check rather than hiding behind a healthy proxy.
	handle /healthz {
		rewrite * /api/v1/ping
		reverse_proxy localhost:4173
	}

	# The web client and its websocket. nsflow talks to the neuro-san server on
	# localhost itself, so that server needs no route here.
	handle {
		basic_auth {
			{$DESK_USERNAME} {$DESK_PASSWORD_HASH}
		}
		reverse_proxy localhost:4173
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
	}
}
